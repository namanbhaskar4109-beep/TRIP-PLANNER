# ==========================================
# MONGODB ATLAS & SERVER CONFIGURATION
# ==========================================

# 1. MongoDB Atlas Connection URI:
# Steps to obtain from MongoDB Atlas (cloud.mongodb.com):
# a. Log in to https://cloud.mongodb.com
# b. Click "Network Access" -> "Add IP Address" -> "Allow Access from Anywhere" (0.0.0.0/0)
# c. Click "Database Access" -> Create user with Read and Write privileges
# d. Click "Databases" -> "Connect" -> Choose "Drivers" (Node.js)
# e. Copy connection string and paste below, replacing <password> with your database user password:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tripplanner?retryWrites=true&w=majority

# 2. JWT Secret for user session tokens:
JWT_SECRET=super_secure_jwt_token_secret_trip_planner_atlas_2025

# 3. Server Port:
PORT=5000
